{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned step-ca and step-cli versions in role defaults",
      "managerFilePatterns": ["/^roles/.+/defaults/main\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[a-z_]+: \"?(?<currentValue>[^\"\\n]+)\"?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
